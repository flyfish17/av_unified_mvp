[
 {
  "id": "om-flow-tab",
  "type": "tab",
  "label": "creator_om 越阈示教(只读)",
  "disabled": false,
  "info": "示教 flow:订 telemetry→越阈判定→debug 侧栏展示。2026-08-10 方案①整改:告警发布口(mqtt-out)已摘除,告警唯一正史 = alerting 模块(阈值在 config/thresholds.yaml / 前端阈值页)。此 tab 仅演示 Node-RED 如何订总线做二次开发,不产生告警。"
 },
 {
  "id": "om-broker",
  "type": "mqtt-broker",
  "name": "creator_om 本机总线",
  "broker": "127.0.0.1",
  "port": "1883",
  "clientid": "creator_om_nodered",
  "autoConnect": true,
  "usetls": false,
  "protocolVersion": "4",
  "keepalive": "60",
  "cleansession": true
 },
 {
  "id": "om-in-telemetry",
  "type": "mqtt in",
  "z": "om-flow-tab",
  "name": "订 telemetry",
  "topic": "creator/telemetry/#",
  "qos": "0",
  "datatype": "json",
  "broker": "om-broker",
  "nl": false,
  "rap": true,
  "inputs": 0,
  "x": 140,
  "y": 120,
  "wires": [
   [
    "om-fn-threshold"
   ]
  ]
 },
 {
  "id": "om-fn-threshold",
  "type": "function",
  "z": "om-flow-tab",
  "name": "越阈判定(示教:仅 debug 展示,告警正史在 alerting 模块)",
  "func": "// 阈值表：运维在此修改后点右上角「部署」即时生效\n// level 对齐 205：1=基本 2=重要 3=紧急\nconst TH = {\n    cpu:         { max: 90, level: 2 },\n    memory:      { max: 90, level: 2 },\n    temperature: { max: 65, level: 3 },\n};\nconst parts = msg.topic.split(\"/\");\nconst dev = parts[2], prop = parts[3];\nconst rule = TH[prop];\nif (!rule) return null;\nconst v = parseFloat(msg.payload.value);\nif (isNaN(v) || v <= rule.max) return null;\nmsg.topic = `creator/alarm/${dev}/${prop}`;\nmsg.payload = {\n    level: rule.level,\n    value: String(msg.payload.value),\n    status: 1,\n    alarm: `${prop} 越阈(Node-RED): ${v} > ${rule.max}`,\n    ts: msg.payload.ts,\n};\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "x": 420,
  "y": 120,
  "wires": [
   [
    "om-debug"
   ]
  ]
 },
 {
  "id": "om-debug",
  "type": "debug",
  "z": "om-flow-tab",
  "name": "告警调试",
  "active": true,
  "tosidebar": true,
  "console": false,
  "complete": "payload",
  "x": 690,
  "y": 160,
  "wires": []
 },
 {
  "id": "ccr-tab",
  "type": "tab",
  "label": "CC 演示中控(62面板+真实协议链)",
  "disabled": false,
  "info": "2026-08-20 合并版 = 62版式整页面板 + 公司程序真实协议链。\n62面板按钮路由:空调=Modbus RTU 帧(从机0x32)→_dev:'ac';会议开始/结束=真实时序展开;灯/窗帘/全灯关=公司程序档案无此协议,安全占位仅记录。\n协议链(映射 docs/公司中控程序.txt+接口.txt+空调控制-协议记录.md):电源=TCP 5.21:38388 'PWR ON<n>\\r';矩阵=TCP 5.60:9876 'CutMatrix_源:1_组播:5000;';空调=TCP 5.211:82 Modbus;音量=串口 com1/ttyS3(RS232 hex,本地无害)。\n🔴 安全:ccr-config.live=false(默认位) 时全部 TCP 走本机 echo 127.0.0.1:7101 不碰真设备;live=true 才切真设备 IP。切 live 前必须于总确认现场设备可达。"
 },
 {
  "id": "ccr-config",
  "type": "function",
  "z": "ccr-tab",
  "name": "端点配置(live开关)",
  "func": "// 单点配置:改 live 切安全/真实。真设备 IP 来自公司程序+接口.txt+空调协议记录\nflow.set('cfg', {\n  live: false,                    // ← 🔴 默认位=false 安全红线:全部 TCP 走本机 echo,不碰真设备\n  power:  {ip:'192.168.5.21',  port:38388},  // 继电器1/电源器(live=true 才发)\n  matrix: {ip:'192.168.5.60',  port:9876},   // 分布式矩阵(live=true 才发)\n  ac:     {ip:'192.168.5.211', port:82},     // 空调网关 USR-TCP232-304,Modbus RTU 透传(已实测 ACK;live=true 才发)\n  echo:   {ip:'127.0.0.1',     port:7101},   // 安全回显\n});\nnode.warn('CC 中控配置载入: live=' + flow.get('cfg').live);\n// 推 live 状态到 62 面板页脚(\"安全演示/真设备\"可视)\nreturn {payload:{_state:{live: flow.get('cfg').live}}};",
  "outputs": 1,
  "x": 160,
  "y": 60,
  "wires": [
   [
    "ccp-tpl"
   ]
  ]
 },
