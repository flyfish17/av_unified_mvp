  "id": "ccp-tpl",
  "type": "ui-template",
  "z": "ccr-tab",
  "group": "ccp-group",
  "name": "62面板",
  "order": 1,
  "width": "0",
  "height": "0",
  "head": "",
  "format": "\n<template>\n  <div class=\"ccp\">\n    <div class=\"ccp-head\">\n      <div class=\"ccp-brand\"><span class=\"dot\"></span>CREATOR <span class=\"sep\">·</span> 演示中控</div>\n      <div class=\"ccp-scenes\">\n        <button class=\"scene sc-start\" @click=\"scene('start')\"><span class=\"ic\">▶</span>会议开始</button>\n        <button class=\"scene sc-end\" @click=\"scene('end')\"><span class=\"ic\">■</span>会议结束</button>\n        <button class=\"scene sc-off\" @click=\"scene('alloff')\">全灯关</button>\n      </div>\n    </div>\n    <div class=\"ccp-grid\">\n      <div class=\"card\" v-for=\"a in areas\" :key=\"a.title\">\n        <div class=\"card-title\"><i></i>{{ a.title }}</div>\n        <div class=\"row\" v-for=\"d in a.items\" :key=\"d.id || d.area\">\n          <div class=\"row-name\"><span class=\"rdot\"></span>{{ d.n }}</div>\n          <div class=\"row-ctrl\">\n            <!-- 灯 toggle -->\n            <label v-if=\"d.t==='toggle'\" class=\"sw\" :class=\"{on:st[d.id]}\" @click=\"toggle(d)\">\n              <span class=\"knob\"></span>\n            </label>\n            <!-- 窗帘 开停合 -->\n            <div v-else-if=\"d.t==='curtain'\" class=\"curtain\">\n              <button class=\"cb blue\" @click=\"curtain(d,'open')\">开</button>\n              <button class=\"cb orange\" @click=\"curtain(d,'stop')\">停</button>\n              <button class=\"cb blue\" @click=\"curtain(d,'close')\">合</button>\n            </div>\n            <!-- 空调 - + toggle -->\n            <div v-else-if=\"d.t==='ac'\" class=\"ac\">\n              <button class=\"acb\" @click=\"ac(d,'tempdown')\">−</button>\n              <span class=\"actemp\">{{ acs[d.area] && acs[d.area].on ? (acs[d.area].temp+'℃') : '' }}</span>\n              <button class=\"acb\" @click=\"ac(d,'tempup')\">+</button>\n              <label class=\"sw\" :class=\"{on: acs[d.area] && acs[d.area].on}\" @click=\"ac(d, (acs[d.area]&&acs[d.area].on)?'off':'on')\">\n                <span class=\"knob\"></span>\n              </label>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"ccp-foot\">经 RK3576 盒 · 空调走 USR-TCP232-304(192.168.5.211:82) · 指令源=公司中控程序 · {{ live?'真设备':'安全演示' }}</div>\n  </div>\n</template>\n<script>\nexport default {\n  data(){ return {\n    areas: [{\"title\": \"运营 / 指挥中心\", \"items\": [{\"n\": \"LED 大屏\", \"t\": \"toggle\", \"id\": \"led\"}, {\"n\": \"指挥中心灯带\", \"t\": \"toggle\", \"id\": \"zhzx_dd\"}, {\"n\": \"筒灯\", \"t\": \"toggle\", \"id\": \"tongdeng\"}, {\"n\": \"虚光\", \"t\": \"toggle\", \"id\": \"xuguang\"}, {\"n\": \"发光字\", \"t\": \"toggle\", \"id\": \"faguangzi\"}, {\"n\": \"鲲景观\", \"t\": \"toggle\", \"id\": \"kunjg\"}, {\"n\": \"指挥中心窗帘\", \"t\": \"curtain\", \"id\": \"zhzx_cl\"}, {\"n\": \"运营中心空调\", \"t\": \"ac\", \"area\": \"yy\"}]}, {\"title\": \"一楼公共\", \"items\": [{\"n\": \"走廊轨道灯\", \"t\": \"toggle\", \"id\": \"zl_gd\"}, {\"n\": \"走廊灯带\", \"t\": \"toggle\", \"id\": \"zl_dd\"}, {\"n\": \"走廊发光字\", \"t\": \"toggle\", \"id\": \"zl_fgz\"}, {\"n\": \"会客室轨道灯\", \"t\": \"toggle\", \"id\": \"hks_gd\"}, {\"n\": \"吧台灯带\", \"t\": \"toggle\", \"id\": \"bt_dd\"}, {\"n\": \"吧台窗帘\", \"t\": \"curtain\", \"id\": \"bt_cl\"}, {\"n\": \"洽谈室轨道灯\", \"t\": \"toggle\", \"id\": \"qts_gd\"}]}, {\"title\": \"会议区\", \"items\": [{\"n\": \"会议室1灯带\", \"t\": \"toggle\", \"id\": \"hy1_dd\"}, {\"n\": \"会议室1窗帘\", \"t\": \"curtain\", \"id\": \"hy1_cl\"}, {\"n\": \"会议室2灯带\", \"t\": \"toggle\", \"id\": \"hy2_dd\"}, {\"n\": \"会议室2窗帘\", \"t\": \"curtain\", \"id\": \"hy2_cl\"}]}, {\"title\": \"二楼办公\", \"items\": [{\"n\": \"小楼梯轨道灯\", \"t\": \"toggle\", \"id\": \"xlt_gd\"}, {\"n\": \"餐桌灯带1\", \"t\": \"toggle\", \"id\": \"cz_dd1\"}, {\"n\": \"餐桌灯带2\", \"t\": \"toggle\", \"id\": \"cz_dd2\"}, {\"n\": \"研发部轨道灯\", \"t\": \"toggle\", \"id\": \"yf_gd\"}, {\"n\": \"研发部窗帘\", \"t\": \"curtain\", \"id\": \"yf_cl\"}, {\"n\": \"研发部空调\", \"t\": \"ac\", \"area\": \"yf\"}, {\"n\": \"二楼餐桌空调\", \"t\": \"ac\", \"area\": \"cz\"}, {\"n\": \"工程部轨道灯\", \"t\": \"toggle\", \"id\": \"gc_gd\"}, {\"n\": \"会客厅轨道灯\", \"t\": \"toggle\", \"id\": \"hkt_gd\"}, {\"n\": \"财务室灯带\", \"t\": \"toggle\", \"id\": \"cw_dd\"}, {\"n\": \"机房空调\", \"t\": \"ac\", \"area\": \"jf\"}]}],\n    st: {},            // 灯开关状态\n    acs: { cz:{on:false,temp:21}, yf:{on:false,temp:16}, jf:{on:false,temp:16}, yy:{on:false,temp:16} },\n    live: false,\n  }},\n  methods:{\n    toggle(d){ this.st[d.id] = !this.st[d.id]; this.send({payload:{t:'light',id:d.id,name:d.n,on:this.st[d.id]}}); },\n    curtain(d,act){ this.send({payload:{t:'curtain',id:d.id,name:d.n,act}}); },\n    ac(d,act){\n      const s=this.acs[d.area];\n      if(act==='on'){ s.on=true; } else if(act==='off'){ s.on=false; }\n      else if(act==='tempup'){ s.temp=Math.min(32,s.temp+1); }\n      else if(act==='tempdown'){ s.temp=Math.max(16,s.temp-1); }\n      this.send({payload:{t:'ac',area:d.area,name:d.n,act,temp:s.temp}});\n    },\n    scene(s){ this.send({payload:{t:'scene',scene:s}}); }\n  },\n  watch:{ msg(m){ if(m&&m.payload&&m.payload._state){ this.live = !!m.payload._state.live; } } } // live 由 ccr-config 推入,页脚显示 安全演示/真设备\n}\n</script>\n<style>\n.ccp{ font-family:-apple-system,\"PingFang SC\",\"Microsoft YaHei\",sans-serif; color:#e6edf7;\n  background:radial-gradient(1200px 700px at 15% -10%,#12243f 0%,#0b1424 45%,#0a1018 100%); min-height:100vh; padding:22px 26px; box-sizing:border-box;}\n.ccp-head{ display:flex; align-items:center; justify-content:space-between; padding:6px 8px 18px; border-bottom:1px solid rgba(53,197,216,.18); margin-bottom:20px;}\n.ccp-brand{ font-size:26px; font-weight:800; letter-spacing:1px; display:flex; align-items:center; gap:12px;}\n.ccp-brand .dot{ width:11px;height:11px;border-radius:50%;background:#35c5d8;box-shadow:0 0 14px #35c5d8;}\n.ccp-brand .sep{ color:#35c5d8;}\n.ccp-scenes{ display:flex; gap:14px;}\n.scene{ min-width:120px; height:46px; border-radius:12px; font-size:15px; font-weight:700; cursor:pointer;\n  border:1px solid transparent; color:#e6edf7; display:flex;align-items:center;justify-content:center;gap:7px;}\n.scene .ic{ font-size:12px;}\n.sc-start{ background:linear-gradient(160deg,#1f7a4d,#186640); border-color:#2ea968;}\n.sc-end{ background:linear-gradient(160deg,#2a3446,#222b3a); border-color:#3a4658;}\n.sc-off{ background:transparent; border-color:#c0524e; color:#e79893;}\n.scene:hover{ filter:brightness(1.12);}\n.ccp-grid{ display:grid; grid-template-columns:1fr 1fr; gap:22px;}\n.card{ background:linear-gradient(165deg,#101d33,#0d1728); border:1px solid #22406a; border-radius:16px;\n  padding:20px 22px; box-shadow:0 10px 34px rgba(0,0,0,.42), inset 0 1px 0 rgba(255,255,255,.03);}\n.card-title{ font-size:16px; font-weight:700; color:#35c5d8; letter-spacing:.6px; display:flex;align-items:center;gap:10px;\n  padding-bottom:14px; margin-bottom:6px; border-bottom:1px solid rgba(53,197,216,.14);}\n.card-title i{ width:4px; height:16px; border-radius:2px; background:#35c5d8; box-shadow:0 0 8px #35c5d8;}\n.row{ display:flex; align-items:center; justify-content:space-between; padding:11px 4px; }\n.row-name{ display:flex; align-items:center; gap:12px; font-size:15px; color:#d7e0ec;}\n.row-name .rdot{ width:7px;height:7px;border-radius:50%;background:#4a5b73;}\n.row-ctrl{ display:flex; align-items:center; gap:10px;}\n/* toggle 开关 */\n.sw{ width:52px;height:28px;border-radius:16px;background:#2a3547; background:#2a3547; position:relative; cursor:pointer; transition:background .2s; display:inline-block;}\n.sw .knob{ position:absolute; top:3px; left:3px; width:22px;height:22px;border-radius:50%; background:#e6edf7; transition:left .2s; box-shadow:0 1px 3px rgba(0,0,0,.4);}\n.sw.on{ background:linear-gradient(90deg,#2c8fa8,#35c5d8);}\n.sw.on .knob{ left:27px;}\n/* 窗帘 开停合 */\n.curtain{ display:flex; gap:8px;}\n.cb{ width:40px;height:34px;border-radius:9px;background:#122138;font-size:14px;font-weight:600;cursor:pointer;color:#cdd8e6;}\n.cb.blue{ border:1px solid #2f6ba8;}\n.cb.orange{ border:1px solid #c88a2e; color:#e6b263;}\n.cb:hover{ filter:brightness(1.18);}\n/* 空调 */\n.ac{ display:flex; align-items:center; gap:9px;}\n.acb{ width:34px;height:34px;border-radius:9px;background:#122138;border:1px solid #2f6ba8;color:#cdd8e6;font-size:18px;font-weight:700;cursor:pointer;}\n.acb:hover{ filter:brightness(1.18);}\n.actemp{ min-width:38px;text-align:center;font-size:14px;color:#35c5d8;font-weight:700;}\n.ccp-foot{ text-align:center; color:#5f7691; color:#5f7691; font-size:12.5px; margin-top:26px; padding-top:16px;}\n@media(max-width:900px){ .ccp-grid{ grid-template-columns:1fr; } }\n</style>\n",
  "storeOutMessages": true,
  "passthru": false,
  "resendOnRefresh": true,
  "templateScope": "widget",
  "className": "",
  "x": 200,
  "y": 1080,
  "wires": [
   [
    "ccp-router"
   ]
  ]
 },
 {
  "id": "ccp-router",
  "type": "function",
  "z": "ccr-tab",
  "name": "设备路由",
  "func": "\n// 62 面板设备路由(2026-08-20 合并版): 面板按钮 → 真实协议链\n// 出口1=ccr-tcp-route(统一 live/echo 路由) 出口2=ccr-scene-fn(会议真实时序) 出口3=诊断记录\n// CRC16 Modbus(空调走 USR-TCP232-304 透传, Modbus RTU 从机 0x32)\nfunction crc16(buf){ let c=0xFFFF; for(let i=0;i<buf.length;i++){ c^=buf[i]; for(let j=0;j<8;j++){ if(c&1){c=(c>>1)^0xA001;} else {c>>=1;} } } return c; }\nfunction modbus(regHex, valHex){ // 06 写单寄存器\n  const body=[0x32,0x06, parseInt(regHex.slice(0,2),16),parseInt(regHex.slice(2,4),16),\n              (valHex>>8)&0xff, valHex&0xff];\n  const c=crc16(body); body.push(c&0xff,(c>>8)&0xff); return Buffer.from(body);\n}\n// 4空调查询基址 → 控制寄存器 = 基址+偏移(见 docs/空调控制-协议记录.md)\nconst AC_BASE={cz:0x9C5C, yf:0x9CB7, jf:0x9D12, yy:0x9D6D};\nconst p=msg.payload||{};\n// ── 空调: 组真实 Modbus 帧,交 ccr-tcp-route 统一路由(live=false 默认走 echo,不碰 5.211:82)\nif(p.t==='ac'){\n  const base=AC_BASE[p.area]; const sw=(base+0x32).toString(16).toUpperCase().padStart(4,'0');\n  const tp=(base+0x35).toString(16).toUpperCase().padStart(4,'0');\n  let frame;\n  if(p.act==='on')  frame=modbus(sw,0x0001);\n  else if(p.act==='off') frame=modbus(sw,0x0000);\n  else { frame=modbus(tp, p.temp); } // 温度=摄氏值\n  node.send([{payload:frame, _dev:'ac', _label:`空调 ${p.name} ${p.act}`}, null, null]);\n  return;\n}\n// ── 会议场景 start/end: 走公司程序真实时序展开(CutMatrix+PWR,同受 live 开关管)\nif(p.t==='scene' && (p.scene==='start'||p.scene==='end')){\n  node.send([null, {payload:p.scene}, null]);\n  return;\n}\n// ── 灯/窗帘/全灯关: 公司程序档案无此三类协议 → 安全占位,仅记录不发任何设备(红线)\nconst diag=`[占位:${p.t}] ${p.name||p.scene||''} ${p.act||(p.on?'ON':p.on===false?'OFF':'')} (安全演示,未发真设备)`;\nnode.send([null, null, {payload:diag}]);\n",
  "outputs": 3,
  "x": 440,
  "y": 1080,
  "wires": [
   [
    "ccr-tcp-route"
   ],
   [
    "ccr-scene-fn"
   ],
   [
    "ccp-diag",
    "ccr-diag-txt"
   ]
  ]
 },
 {
