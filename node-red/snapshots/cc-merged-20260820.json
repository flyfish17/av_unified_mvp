 {
  "id": "ccr-tcp-route",
  "type": "function",
  "z": "ccr-tab",
  "name": "TCP路由(live/echo)",
  "func": "const cfg = flow.get('cfg') || {live:false, echo:{ip:'127.0.0.1',port:7101}};\nconst dev = msg._dev;\nconst tgt = (cfg.live && cfg[dev]) ? cfg[dev] : cfg.echo;   // 未知 _dev 一律保底 echo\nmsg.host = tgt.ip; msg.port = tgt.port;\n// 回显:把真实帧+目标发到指令监视(Buffer 显示 hex)\nconst fr = Buffer.isBuffer(msg.payload) ? msg.payload.toString('hex') : JSON.stringify(msg.payload);\nnode.send([msg, {payload: `[${cfg.live?'真设备':'echo'}] ${msg._label||dev} ${tgt.ip}:${tgt.port} ← ${fr}`}]);\nreturn null;",
  "outputs": 2,
  "x": 620,
  "y": 420,
  "wires": [
   [
    "ccr-tcp-req"
   ],
   [
    "ccr-diag-txt",
    "ccr-diag-dbg"
   ]
  ]
 },
