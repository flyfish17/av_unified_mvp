 {
  "id": "ccr-css",
  "type": "ui-template",
  "name": "全站CSS主题",
  "ui": "ccp-base",
  "group": "",
  "template": "\n<style>\n/* ===== CC 中控 · 2代面板美化主题(选择器对齐 Dashboard 2.0 真实类名) ===== */\n:root{\n  --cc-accent:#3aa0ff; --cc-accent2:#38e1c8; --cc-text:#e6edf7; --cc-glow:rgba(58,160,255,.55);\n}\n/* 页面深色科技渐变底 */\n.nrdb-app{\n  background:radial-gradient(1200px 620px at 18% -12%, #172c50 0%, #0f1b30 42%, #0b1220 100%) !important;\n  color:var(--cc-text) !important; font-family:-apple-system,\"PingFang SC\",\"Microsoft YaHei\",sans-serif !important;\n}\n/* 顶栏 */\n.nrdb-app .v-app-bar, .nrdb-app header.v-toolbar{\n  background:linear-gradient(90deg,#0d1a30,#12243f) !important;\n  box-shadow:0 2px 18px rgba(0,0,0,.45) !important; border-bottom:1px solid rgba(58,160,255,.18) !important;\n}\n/* 分区卡片:玻璃质感 + 主色描边 + 阴影(覆盖 scoped 样式靠 !important) */\n.nrdb-app .nrdb-layout-group--grid{\n  background:linear-gradient(160deg,#1a2942,#141f33) !important;\n  border:1px solid rgba(58,160,255,.22) !important; border-radius:16px !important;\n  box-shadow:0 8px 30px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.04) !important;\n}\n/* 分区标题行 */\n.nrdb-app .group-header-row, .nrdb-app .group-header-row *{\n  color:var(--cc-accent) !important; font-weight:700 !important; letter-spacing:.5px;\n  font-size:15px !important; text-shadow:0 0 12px rgba(58,160,255,.35);\n}\n/* 按钮:大圆角 + 渐变 + 悬浮/按下发光(Vuetify v-btn) */\n.nrdb-app .v-btn{\n  border-radius:14px !important; font-weight:700 !important; letter-spacing:.5px;\n  min-height:54px !important; text-transform:none !important; font-size:15px !important;\n  background:linear-gradient(150deg,#223a5c,#182a44) !important; color:var(--cc-text) !important;\n  border:1px solid rgba(58,160,255,.30) !important;\n  box-shadow:0 6px 18px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.06) !important;\n  transition:transform .08s ease, box-shadow .2s ease, background .2s ease !important;\n}\n.nrdb-app .v-btn:hover{\n  background:linear-gradient(150deg,#2b4a76,#1d3454) !important;\n  box-shadow:0 8px 26px var(--cc-glow), inset 0 1px 0 rgba(255,255,255,.08) !important;\n  transform:translateY(-1px);\n}\n.nrdb-app .v-btn:active{ transform:translateY(1px) scale(.98); }\n.nrdb-app .v-btn .v-icon{ font-size:24px !important; color:var(--cc-accent2) !important; }\n/* 文本/状态胶囊 */\n.nrdb-app .nrdb-ui-text{\n  background:linear-gradient(160deg,#122036,#0e1a2c) !important; border-radius:12px !important;\n  border:1px solid rgba(56,225,200,.22) !important; padding:10px 14px !important;\n  box-shadow:inset 0 1px 0 rgba(255,255,255,.05) !important;\n}\n.nrdb-app .nrdb-ui-text-value{ color:var(--cc-accent2) !important; font-weight:700 !important; font-size:16px !important; }\n.nrdb-app .nrdb-ui-text-label{ color:#9fb3cc !important; }\n/* 滑条主色 */\n.nrdb-app .v-slider-track__fill{ background:var(--cc-accent) !important; }\n.nrdb-app .v-slider-thumb__surface{ background:var(--cc-accent) !important; }\n/* 左侧导航 */\n.nrdb-app .v-navigation-drawer{ background:linear-gradient(180deg,#0e1b31,#0b1626) !important; border-right:1px solid rgba(58,160,255,.15) !important; }\n.nrdb-app .v-list-item--active{ background:linear-gradient(90deg,rgba(58,160,255,.18),transparent) !important; border-left:3px solid var(--cc-accent) !important; }\n</style>\n",
  "format": "css",
  "storeOutMessages": false,
  "passthru": false,
  "resendOnRefresh": true,
  "templateScope": "site",
  "className": "",
  "x": 160,
  "y": 980,
  "wires": [
   []
  ]
