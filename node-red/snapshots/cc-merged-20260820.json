 {
  "id": "ccr-vol-frame",
  "type": "function",
  "z": "ccr-tab",
  "name": "组音量hex帧→字节",
  "func": "const {n, code} = msg.payload;\n// 公司程序 SEND_COM(com,1,'0x012003001000061000A5E8000B0<n>0040'),code=0B加/0C减\nconst full = '012003001000061000A5E8' + '00' + code + '0' + n + '0040';\nmsg.payload = Buffer.from(full, 'hex');\nmsg._frameHex = full;\nnode.send([msg, {payload:`[串口 com1/ttyS3] 音量 ← ${full}`}]);\nreturn null;",
  "outputs": 2,
  "x": 420,
  "y": 760,
  "wires": [
   [
    "ccr-serial-out"
   ],
   [
    "ccr-diag-txt",
    "ccr-diag-dbg"
   ]
  ]
 },
