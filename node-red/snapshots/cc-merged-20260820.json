 {
  "id": "ccr-scene-fn",
  "type": "function",
  "z": "ccr-tab",
  "name": "会议场景展开(真实时序)",
  "func": "// 映射公司程序 tp401 开始会议 / tp402 结束会议\nconst mx = (src,mcast,d)=>setTimeout(()=>node.send({payload:`CutMatrix_${src}:1_${mcast}:5000;`,_dev:'matrix'}),d);\nconst pw = (frame,d)=>setTimeout(()=>node.send({payload:frame,_dev:'power'}),d);\nif (msg.payload==='start') {\n  mx('192.168.5.11','224.1.1.30',0);      // 左电脑→LED\n  mx('192.168.5.17','224.1.1.35',200);    // 摄像机→采集卡\n  pw('PWR ON1\\r',400);                    // LED电源开\n  pw('PWR OFF3\\r',600);\n  node.status({fill:'green',shape:'dot',text:'会议中'});\n} else {\n  pw('PWR OFF1\\r',0); pw('PWR OFF4\\r',200); pw('PWR ON3\\r',400);\n  node.status({fill:'grey',shape:'ring',text:'已结束'});\n}\nreturn null;",
  "outputs": 1,
  "x": 440,
  "y": 130,
  "wires": [
   [
    "ccr-tcp-route"
   ]
  ]
 },
