,255,.3);box-shadow:0 0 14px rgba(0,200,255,.4)}\n.sbtn.on{background:linear-gradient(135deg,#0a8a4a,#0d6b3a);border-color:#1ec878;color:#eafff3}\n.sbtn.off{background:linear-gradient(135deg,#3a4a5a,#2a3742);border-color:#5a6b7a}\n.sbtn.alloff{border-color:rgba(255,120,120,.5);color:#ffcaca}\n.zwrap{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}\n.zone{background:rgba(9,26,46,.55);border:1px solid rgba(0,180,255,.2);border-radius:12px;padding:14px 16px;\n box-shadow:inset 0 0 30px rgba(0,120,200,.06),0 4px 20px rgba(0,0,0,.3);backdrop-filter:blur(6px)}\n.ztitle{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:700;letter-spacing:1.5px;\n color:#4fd6ff;text-transform:uppercase;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid rgba(0,180,255,.12)}\n.bar{width:4px;height:16px;background:linear-gradient(#00e0ff,#0088cc);border-radius:2px;box-shadow:0 0 8px #00e0ff}\n.dev{display:flex;align-items:center;gap:10px;padding:9px 8px;border-radius:8px;transition:.15s}\n.dev:hover{background:rgba(0,150,255,.06)}\n.dev.lit{background:rgba(0,200,255,.08)}\n.ico{width:7px;height:7px;border-radius:50%;background:#33465a;flex-shrink:0;transition:.2s}\n.dev.lit .ico{background:#00e6ff;box-shadow:0 0 10px #00e6ff}\n.dlab{flex:1;font-size:14px;color:#b8d0e2}\n.dev.lit .dlab{color:#fff}\n.sw{cursor:pointer;flex-shrink:0}\n.track{display:block;width:44px;height:24px;border-radius:12px;background:#26384a;position:relative;transition:.2s;border:1px solid rgba(255,255,255,.08)}\n.dev.lit .track{background:linear-gradient(135deg,#0090cc,#00d0a0);box-shadow:0 0 12px rgba(0,210,180,.5)}\n.knob{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#dfeefc;transition:.2s}\n.dev.lit .knob{left:23px}\n.cur{display:flex;gap:5px}\n.cur button{border:1px solid rgba(0,180,255,.3);background:rgba(0,120,180,.12);color:#bfe9ff;\n width:34px;height:30px;border-radius:6px;cursor:pointer;font-size:13px;transition:.15s}\n.cur button:hover{background:rgba(0,180,255,.28);box-shadow:0 0 10px rgba(0,200,255,.35)}\n.cur button.stop{border-color:rgba(255,180,80,.4);color:#ffd9a0}\n.acx{display:flex;gap:6px;align-items:center}\n.acx .tmp{border:1px solid rgba(0,180,255,.3);background:rgba(0,120,180,.12);color:#bfe9ff;\n width:30px;height:30px;border-radius:6px;cursor:pointer;font-size:16px;line-height:1;transition:.15s}\n.acx .tmp:hover{background:rgba(0,180,255,.28)}\n.foot{margin-top:18px;font-size:11px;color:#556f85;text-align:center;letter-spacing:.5px}\n</style>","storeOutMessages":false,"passthru":false,"resendOnRefresh":false,"templateScope":"local","className":"","x":250,"y":120,"wires":[["4fb3207ffc1c4e9d"]]},{"id":"4fb3207ffc1c4e9d","type":"function","z":"6381f8389711479e","name":"路由(明文.20:8932 / PDU:38388)","func":"const p=msg.payload||{};\nif(p.t==='p'){ msg.host=p.h; msg.port=38388; msg.payload=p.c; }\nelse { msg.host='192.168.5.20'; msg.port=8932; msg.payload=p.c; }\nreturn msg;","outputs":1,"noerr":0,"x":530,"y":120,"wires":[["4061810dba2f4cae"]]},{"id":"4061810dba2f4cae","type":"tcp out","z":"6381f8389711479e","name":"→短连接(仿语音版)","host":"","port":"","beserver":"client","base64":false,"end":true,"tls":"","x":800,"y":120,"wires":[]}]