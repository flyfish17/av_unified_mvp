msg?.payload?.vision?.detected ? '#38bdf8' : '#334155'\" stroke-width=\"2\"\n          style=\"transition: all 0.5s ease;\" />\n        <text x=\"70\" y=\"210\" :fill=\"msg?.payload?.vision?.detected ? '#f8fafc' : '#cbd5e1'\" font-size=\"18\"\n          font-weight=\"bold\">视觉感知眼睛</text>\n        <text x=\"70\" y=\"235\" fill=\"#94a3b8\" font-size=\"12\">CodeProject.AI Camera</text>\n        <circle cx=\"80\" cy=\"275\" r=\"8\" :fill=\"msg?.payload?.vision?.detected ? '#38bdf8' : '#475569'\"\n          :filter=\"msg?.payload?.vision?.detected ? 'url(#glow)' : ''\" />\n        <text x=\"100\" y=\"280\" font-size=\"16\" font-weight=\"bold\"\n          :fill=\"msg?.payload?.vision?.detected ? '#38bdf8' : '#64748b'\">\n          状态: {{ msg?.payload?.vision?.detected ? '目标活动' : '区域待机中' }}\n        </text>\n      </g>\n\n      <g id=\"zone_auditory\">\n        <rect x=\"50\" y=\"320\" width=\"220\" height=\"130\" rx=\"10\"\n          :fill=\"msg?.payload?.audio?.detected ? 'rgba(74, 222, 128, 0.15)' : 'rgba(30, 41, 59, 0.8)'\"\n          :stroke=\"msg?.payload?.audio?.detected ? '#4ade80' : '#334155'\" stroke-width=\"2\"\n          style=\"transition: all 0.5s ease;\" />\n        <text x=\"70\" y=\"360\" :fill=\"msg?.payload?.audio?.detected ? '#f8fafc' : '#cbd5e1'\" font-size=\"18\"\n          font-weight=\"bold\">听觉感知耳朵</text>\n        <text x=\"70\" y=\"385\" fill=\"#94a3b8\" font-size=\"12\">FunASR Python Voice</text>\n        <circle cx=\"80\" cy=\"425\" r=\"8\" :fill=\"msg?.payload?.audio?.detected ? '#4ade80' : '#475569'\"\n          :filter=\"msg?.payload?.audio?.detected ? 'url(#glow)' : ''\" />\n        <text x=\"100\" y=\"430\" font-size=\"16\" font-weight=\"bold\"\n          :fill=\"msg?.payload?.audio?.detected ? '#4ade80' : '#64748b'\">\n          状态: {{ msg?.payload?.audio?.detected ? '指令处理' : '网络空闲' }}\n        </text>\n      </g>\n\n      <path d=\"M 270 235 C 325 235, 325 310, 380 310\" stroke=\"#1e293b\" stroke-width=\"6\" fill=\"none\" />\n      <path d=\"M 270 385 C 325 385, 325 310, 380 310\" stroke=\"#1e293b\" stroke-width=\"6\" fill=\"none\" />\n      <path d=\"M 560 310 L 680 310\" stroke=\"#1e293b\" stroke-width=\"6\" fill=\"none\" />\n\n\n      <path d=\"M 270 235 C 325 235, 325 310, 380 310\" stroke=\"#38bdf8\" stroke-width=\"3\" fill=\"none\"\n        :class=\"{'flow-fast': msg?.payload?.vision?.detected}\" />\n\n      <path d=\"M 270 385 C 325 385, 325 310, 380 310\" stroke=\"#4ade80\" stroke-width=\"3\" fill=\"none\"\n        :class=\"{'flow-fast': msg?.payload?.audio?.detected}\" />\n\n      <path d=\"M 560 310 L 680 310\" stroke=\"#a855f7\" stroke-width=\"3\" fill=\"none\"\n        :class=\"{'flow-fast': msg?.payload?.equipment?.fsp_active}\" />\n\n      <g id=\"creator_brain\">\n        <rect x=\"380\" y=\"220\" width=\"180\" height=\"180\" rx=\"10\"\n          :fill=\"(msg?.payload?.vision?.detected || msg?.payload?.audio?.detected) ? 'rgba(168, 85, 247, 0.2)' : 'rgba(15, 23, 42, 0.9)'\"\n          :stroke=\"(msg?.payload?.vision?.detected || msg?.payload?.audio?.detected) ? '#a855f7' : '#1e3a8a'\"\n          stroke-width=\"3\" style=\"transition: all 0.3s ease;\" />\n        <text x=\"405\" y=\"280\" fill=\"#f8fafc\" font-size=\"22\" font-weight=\"bold\" font-family=\"sans-serif\">AI大脑</text>\n        <text x=\"405\" y=\"310\" fill=\"#94a3b8\" font-size=\"12\">Ollama / Qwen Inference</text>\n        <text x=\"405\" y=\"370\" font-size=\"16\" font-weight=\"bold\"\n          :fill=\"(msg?.payload?.vision?.detected || msg?.payload?.audio?.detected) ? '#a855f7' : '#64748b'\">\n          {{ (msg?.payload?.vision?.detected || msg?.payload?.audio?.detected) ? '思考中...' : '网络待命' }}\n        </text>\n      </g>\n\n\n      <g id=\"creator_matrix\">\n        <rect x=\"680\" y=\"220\" width=\"160\" height=\"180\" rx=\"10\"\n          :fill=\"msg?.payload?.equipment?.fsp_active ? 'rgba(239, 68, 68, 0.15)' : 'rgba(15, 23, 42, 0.9)'\"\n          :stroke=\"msg?.payload?.equipment?.fsp_active ? '#ef4444' : '#1e3a8a