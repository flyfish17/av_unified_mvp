in":"false","willPayload":"","willMsg":{},"userProps":"","sessionExpiry":""},{"id":"92d2ae0841c5252f","type":"ui_text_input","z":"7c4ca99dac54bb67","name":"指令输入端(备用)","label":"AI管家指令输入：","tooltip":"默认位置：二楼餐桌","group":"ui_group_main","order":1,"width":8,"height":1,"passthru":true,"mode":"text","delay":300,"topic":"topic","sendOnBlur":true,"className":"","topicType":"msg","x":210,"y":360,"wires":[["fa9fa342d4437e9e"]]},{"id":"6fe7ba9e49606ee4","type":"http in","z":"7c4ca99dac54bb67","name":"📱 Siri 唤醒入口","url":"/siri","method":"post","upload":false,"swaggerDoc":"","x":200,"y":580,"wires":[["6cb08840907e1221"]]},{"id":"6cb08840907e1221","type":"function","z":"7c4ca99dac54bb67","name":"解析 Siri 文本","func":"// 提取手机发来的JSON中的文本内容\nmsg.payload = msg.payload.text || \"\";\nreturn msg;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":200,"y":520,"wires":[["2dac637fe50f9a8b"]]},{"id":"fa9fa342d4437e9e","type":"function","z":"7c4ca99dac54bb67","name":"1. AI 大脑 Prompt","func":"// ==========================================\n// 纯本地边缘计算模式 (指向本机的 0.8b 模型)\n// ==========================================\nvar apiKey = \"\";\n\nvar systemPrompt = `你是底层音视频中控指令翻译器。禁止任何思考、推理或废话。无需解释原因。直接输出JSON！格式。\n当前用户默认位置在“二楼餐桌(2FDiningTable)”。\n\n【核心任务】：将用户的自然语言翻译为系统可执行的ASCII指令。\n\n【高级逻辑推理】：\n- “有点热”/“太闷了” -> 打开默认位置空调，或发送 TempDown。\n- “有点冷” -> 关闭空调，或发送 TempUp。\n- 未指定地点，默认指“二楼餐桌”。\n\n【可用指令字典】：\n[二楼餐桌] 空调开: 2FDiningTable_AirConditioner_On, 空调关: 2FDiningTable_AirConditioner_Off, 温度+: 2FDiningTable_AirConditioner_TempUp, 温度-: 2FDiningTable_AirConditioner_TempDown, 灯带1开/关: DiningTable_Light1_On/Off\n[机房] 空调开: EngineRoom_AirConditioner_On, 空调关: EngineRoom_AirConditioner_Off\n[会议室1] 窗帘开: MeetingRoom1_Curtain_Open\n\n【绝对禁止】：包含其他废话。禁止思考！\n【强制要求】：严格以纯JSON格式输出。\n\n【标准示例】(注意学习这种格式):\n用户输入：二楼有点热\n系统输出：\n{\n  \"commands\": [\"2FDiningTable_AirConditioner_On\", \"2FDiningTable_AirConditioner_TempDown\"],\n  \"reply\": \"已为您开启二楼餐桌空调，并调低温度。\"\n}`;\n\nvar userText = msg.payload;\n\nmsg.payload = {\n    \"model\": \"qwen2.5-coder:1.5b\",  // 核心：调用本地 1.5b 模型\n    \"format\": \"json\",       // 【绝对核心】强制 Ollama 进入纯 JSON 输出模式！\n    \"messages\": [\n        { \"role\": \"system\", \"content\": systemPrompt },\n    \n        { \"role\": \"user\", \"content\": userText }\n    ],\n    \"temperature\": 0.1,     // 温度降到0.1，让它不要胡思乱想，老老实实当翻译机\n    \"stream\": false,\n    \"keep_alive\": -1,       // 【关键】-1 表示模型永久常驻内存，拒绝冷启动！\n    \"max_tokens\": 300,      // 【关键】限制模型最多输出 150 个 Token。中控指令越短越好，防止模型啰嗦导致超时。\n    \"response_format\": { \"type\": \"json_object\" }\n};\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\",\n    \"Authorization\": \"Bearer \" + apiKey\n};\n\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":520,"y":360,"wires":[["f67977ef427f0ec4"]]},{"id":"f67977ef427f0ec4","type":"http request","z":"7c4ca99dac54bb67","name":"2. 请求大模型","method":"POST","ret":"obj","paytoqs":"ignore","url":"http://127.0.0.1:11434/v1/chat/completions","tls":"","persist":false,"proxy":"","insecureHTTPParser":false,"authType":"","senderr":false,"headers":[],"x":500,"y":460,"wires":[["2592ed45bcbf45d2","2dc172095dbda219"]]},{"id":"2592ed45bcbf45d2","type":"function","z":"7c4ca99dac54bb67","name":"3. 提取指令并分发(防丢失)","func":"try {\n    // 1. 获取大模型回复的原始文本\n    var responseText = msg.payload.choices[0].message.content;\n\n    // 【调试辅助】把大模型真实的输出打印在控制台，方便你抓虫\n    node.warn(\"大模型原始输出: \" + responseText);\n\n    // 2. 暴力清洗：只提取第一个 { 和最后一个 } 之间的内容\n    var jsonStart = responseText.indexOf('{');\n    var jsonEnd = responseText.lastIndexOf('}');\n\n    if (jsonStart === -1 || jsonEnd === -1) {\n        throw new Error(\"大模型彻底放飞自我，没有输出包含大括号的结构体\");\n    }\n\n    var cleanJsonStr = responseText.substring(jsonStart, jsonEnd + 1);\n    var aiCommand = JSON.parse(cleanJsonStr);\n\n    // 3. 构造回复消息 (给语音播报或前端反馈用)\n    var replyMsg = Object.assign({}, msg);\n    replyMsg.payload = aiCommand.reply || \"指令已确认\"; // 容错处理\n\n    // 4. 构造指令消息数组 (给下游硬件总线用)\n    var commandMsgs = [];\n    if (aiCommand.commands && Array.isArray(aiCommand.commands)) {\n        aiCommand.commands.forEach(function (cmd) {\n            // 将每个单独的指令包装成一个独立的 payload\n            var newCmdMsg = Object.assign({}, msg);\n            newCmdMsg.payload = cmd;\n            commandMsgs.push(newCmdMsg);\n        });\n    }\n\n    // 5. 按节点端口输出：端口1输出指令数组，端口2输出语音回复\n    return [commandMsgs, replyMsg];\n\n} catch (e) {\n    // 【精确定位】在侧边栏显示具体的报错原因\n    node.error(\"解析 JSON 失败: \" + e.message, msg);\n\n    var errorMsg = Object.assign({}, msg);\n    errorMsg.payload = \"大模型抽风了，请看 Debug 窗口的报错信息。\";\n    // 端口1不发硬件指令，端口2播报错误\n    return [null, errorMsg];\n}","outputs":2,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":490,"y":560,"wires":[["c905fc4ab844349b","0bd9c55fea1d6331","d4ab51320aba6873"],["32365d7f4ae5fcc9","fbb2fd3949e18ae4","fb10df46743ea60c"]]},{"id":"eafea5eb7283ce48","type":"http response","z":"7c4ca99dac54bb67","name":"返回给 Siri 播报","statusCode":"200","headers":{"Content-Type":"text/plain; charset=utf-8"},"x":1060,"y":740,"wires":[]},{"id":"c905fc4ab844349b","type":"delay","z":"7c4ca99dac54bb67","name":"4. 缓冲防并发拥堵","pauseType":"rate","timeout":"5","timeoutUnits":"seconds","rate":"1","nbRateUnits":"0.3","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"allowrate":false,"outputs":1,"x":830,"y":520,"wires":[["96951724545c1f45","6e2993daf0576e1d"]]},{"id":"96951724545c1f45","type":"tcp out","z":"7c4ca99dac54bb67","name":"5. 发送至主机 (192.168.5.20:8932)","host":"192.168.5.20","port":"8932","beserver":"client","base64":false,"end":false,"x":1120,"y":500,"wires":[]},{"id":"6e2993daf0576e1d","type":"debug","z":"7c4ca99dac54bb67","name":"监控发送的ASCII码","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":1070,"y":560,"wires":[]},{"id":"32365d7f4ae5fcc9","type":"ui_text","z":"7c4ca99dac54bb67","group":"ui_group_main","order":2,"width":8,"height":2,"name":"状态反馈","label":"系统反馈：","format":"{{msg.payload}}","layout":"col-center","className":"","x":800,"y":600,"wires":[]},{"id":"373393da38bafa81","type":"ui_audio","z":"7c4ca99dac54bb67","name":"电脑端同步播报","group":"ui_group_main","voice":"","always":true,"x":1060,"y":700,"wires":[]},{"id":"0bd9c55fea1d6331","type":"ui_template","z":"7c4ca99dac54bb67","group":"ui_group_main","name":"📱 动态设备状态墙","order":3,"width":8,"height":3,"format":"<div style=\"display: flex; justify-content: space-around; align-items: center; padding: 20px; background: #1e1e1e; border-radius: 12px; color: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.2);\">\n    \n    <div style=\"text-align: center; transition: all 0.4s ease;\" ng-style=\"{'color': acOn ? '#00e5ff' : '#555', 'transform': acOn ? 'scale(1.1)' : 'scale(1)'}\">\n        <i class=\"fa fa-asterisk\" style=\"font-size: 42px;\" ng-class=\"{'fa-spin': acOn}\"></i>\n        <div style=\"margin-top: 12px; font-size: 16px; font-weight: bold;\">\n            空调状态 <span ng-show=\"acTemp && acOn\">{{acTemp}}℃</span>\n        </div>\n    </div>\n    \n    \n    <div style=\"text-align: center; transition: all 0.4s ease;\" ng-style=\"{'color': lightOn ? '#ffeb3b' : '#555', 'transform': lightOn ? 'scale(1.1)' : 'scale(1)'}\">\n        <i class=\"fa fa-lightbulb-o\" style=\"font-size: 42px;\"></i>\n        <div style=\"margin-top: 12px; font-size: 16px; font-weight: bold;\">\n            环境灯光\n        </div>\n    </div>\n\n    \n    <div style=\"text-align: center; transition: all 0.4s ease;\" ng-style=\"{'color': curtainOpen ? '#4caf50' : '#555'}\">\n        <i class=\"fa\" ng-class=\"curtainOpen ? 'fa-columns' : 'fa-align-justify'\" style=\"font-size: 42px;\"></i>\n        <div style=\"margin-top: 12px; font-size: 16px; font-weight: bold;\">\n            智能窗帘\n        </div>\n    </div>\n</div>\n\n<script>\n(function(scope) {\n    // 初始化状态，默认全部关闭\n    scope.acOn = false;\n    scope.lightOn = false;\n    scope.curtainOpen = false;\n    scope.acTemp = 24; // 默认展示温度\n\n    // 监听从 Node-RED 后端发来的 ASCII 指令\n    scope.$watch('msg', function(msg) {\n        if (!msg) return;\n        var cmd = msg.payload;\n        if (typeof cmd !== 'string') return;\n\n        // --- 空调模糊拦截逻辑 ---\n        if (cmd.includes('AirConditioner_On')) { scope.acOn = true; }\n        if (cmd.includes('AirConditioner_Off')) { scope.acOn = false; }\n        if (cmd.includes('AirConditioner_TempUp')) { scope.acOn = true; scope.acTemp += 1; }\n        if (cmd.includes('AirConditioner_TempDown')) { scope.acOn = true; scope.acTemp -= 1; }\n\n        // --- 灯光模糊拦截逻辑 ---\n        if (cmd.includes('Light') && cmd.includes('_On')) { scope.lightOn = true; }\n        if (cmd.includes('Light') && cmd.includes('_Off')) { scope.lightOn = false; }\n        if (cmd.includes('Downlight_On') || cmd.includes('TrackLight_On')) { scope.lightOn = true; }\n        if (cmd.includes('Downlight_Off') || cmd.includes('TrackLight_Off')) { scope.lightOn = false; }\n\n        // --- 窗帘模糊拦截逻辑 ---\n        if (cmd.includes('Curtain_Open')) { scope.curtainOpen = true; }\n        if (cmd.includes('Curtain_Close')) { scope.curtainOpen = false; }\n    });\n})(scope);\n</script>","storeOutMessages":true,"fwdInMessages":true,"resendOnRefresh":true,"templateScope":"local","className":"","x":830,"y":460,"wires":[[]]},{"id":"d4ab51320aba6873","type":"link out","z":"7c4ca99dac54bb67","name":"发射：Ollama语音意图","mode":"link","links":["fa5bcde2967c4253"],"x":840,"y":560,"wires":[],"l":true},{"id":"d268886d95f21711","type":"mqtt in","z":"7c4ca99dac54bb67","name":"监听: creator/control/voice","topic":"creator/control/voice","qos":"0","datatype":"auto-detect","broker":"2b41081ef4cf12c5","nl":false,"rap":true,"rh":0,"inputs":0,"x":230,"y":160,"wires":[["4ba833c1fe7aa4bb"]]},{"id":"4ba833c1fe7aa4bb","type":"json","z":"7c4ca99dac54bb67","name":"解析 JSON","property":"payload","action":"obj","pretty":false,"x":190,"y":220,"wires":[["5f671faa9b6902f9"]]},{"id":"5f671faa9b6902