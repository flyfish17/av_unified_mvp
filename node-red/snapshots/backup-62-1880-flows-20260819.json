 \"筒灯\", \"p\": \"OperateCentre_Downlight\"}, {\"k\": \"light\", \"label\": \"虚光\", \"p\": \"OperateCentre_VirtualLight\"}, {\"k\": \"light\", \"label\": \"发光字\", \"p\": \"LuminousWord\"}, {\"k\": \"light\", \"label\": \"鲲景观\", \"p\": \"KunScenery\"}, {\"k\": \"curtain\", \"label\": \"指挥中心窗帘\", \"p\": \"OperateCentre_Curtain\"}, {\"k\": \"ac\", \"label\": \"运营中心空调\", \"p\": \"OperateCentre_AirConditioner\"}]}, {\"name\": \"一楼公共\", \"devs\": [{\"k\": \"light\", \"label\": \"走廊轨道灯\", \"p\": \"Corridor_TrackLight\"}, {\"k\": \"light\", \"label\": \"走廊灯带\", \"p\": \"Corridor_Light\"}, {\"k\": \"light\", \"label\": \"走廊发光字\", \"p\": \"Corridor_LuminousWordLight\"}, {\"k\": \"light\", \"label\": \"会客室轨道灯\", \"p\": \"ReceptionRoom_TrackLight\"}, {\"k\": \"light\", \"label\": \"吧台灯带\", \"p\": \"BarCounter_Light\"}, {\"k\": \"curtain\", \"label\": \"吧台窗帘\", \"p\": \"BarCounter_Curtain\"}, {\"k\": \"light\", \"label\": \"洽谈室轨道灯\", \"p\": \"NegotiationRoom_TrackLight\"}]}, {\"name\": \"会议区\", \"devs\": [{\"k\": \"light\", \"label\": \"会议室1灯带\", \"p\": \"MeetingRoom1_Light\"}, {\"k\": \"curtain\", \"label\": \"会议室1窗帘\", \"p\": \"MeetingRoom1_Curtain\"}, {\"k\": \"light\", \"label\": \"会议室2灯带\", \"p\": \"MeetingRoom2_Light\"}, {\"k\": \"curtain\", \"label\": \"会议室2窗帘\", \"p\": \"MeetingRoom2_Curtain\"}]}, {\"name\": \"二楼办公\", \"devs\": [{\"k\": \"light\", \"label\": \"小楼梯轨道灯\", \"p\": \"SmallStairs_TrackLight\"}, {\"k\": \"light\", \"label\": \"餐桌灯带1\", \"p\": \"DiningTable_Light1\"}, {\"k\": \"light\", \"label\": \"餐桌灯带2\", \"p\": \"DiningTable_Light2\"}, {\"k\": \"light\", \"label\": \"研发部轨道灯\", \"p\": \"RDDepartment_TrackLight\"}, {\"k\": \"curtain\", \"label\": \"研发部窗帘\", \"p\": \"RDDepartment_Curtain\"}, {\"k\": \"ac\", \"label\": \"研发部空调\", \"p\": \"RDDepartment_AirConditioner\"}, {\"k\": \"light\", \"label\": \"工程部轨道灯\", \"p\": \"EngineeringDepartment_TrackLight\"}, {\"k\": \"light\", \"label\": \"会客厅轨道灯\", \"p\": \"ReceptionRoom_Light\"}, {\"k\": \"light\", \"label\": \"