e":"function","z":"7c4ca99dac54bb67","name":"拦截系统自身播音","func":"var text = msg.payload;\n\n// 定义系统播报的常用开头或特征词\nvar systemKeywords = [\"以为\", \"已将\", \"已为您\", \"已成功\", \"好的，已\", \"好的\", \"正在为您\", \"大模型抽风了\", \"解析失败\"];\n\nfor (var i = 0; i < systemKeywords.length; i++) {\n    if (text.indexOf(systemKeywords[i]) !== -1) {\n        // 如果检测到这句话是系统自己说的，直接丢弃，不往下传！\n        node.warn(\"拦截到系统自身播报，丢弃录音: \" + text);\n        return null;\n    }\n}\n\n// 如果不是系统说的，正常放行\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":210,"y":320,"wires":[["fa9fa342d4437e9e"]]},{"id":"av_control_in_p0","type":"mqtt in","z":"7c4ca99dac54bb67","name":"av/control (P0)","topic":"av/control","qos":"0","datatype":"auto-detect","broker":"2b41081ef4cf12c5","nl":false,"rap":true,"rh":0,"inputs":0,"x":190,"y":40,"wires":[["av_control_fn_p0"]]},{"id":"av_control_fn_p0","type":"function","z":"7c4ca99dac54bb67","name":"av/control → ASCII","func":"// av/control → ASCII 指令转发到 creator 中控（192.168.5.20:8932）\n// 兼容 3 种 payload：\n//   1. {cmd: \"2FDiningTable_AirConditioner_On\"} 直接 ASCII\n//   2. {location, device, action} 拼 location_device_action\n//   3. BaseModule 双层 {payload: {...}} 取内层\nlet body = msg.payload;\nif (typeof body === \"string\") {\n    try { body = JSON.parse(body); } catch (e) {}\n}\nif (body && typeof body === \"object\" && \"payload\" in body) body = body.payload;\n\n// 字段兼容：cmd（推荐）/ command（llm_engine 旧版本）/ {location,device,action} 三件\nlet cmd = body && (body.cmd || body.command);\nif (!cmd && body && body.location && body.device && body.action) {\n    cmd = body.location + \"_\" + body.device + \"_\" + body.action;\n}\nif (!cmd) {\n    node.warn(\"av/control 无效 payload: \" + JSON.stringify(msg.payload));\n    return null;\n}\n\n// 与 mac 端实测可工作的命令格式严格一致：\n//   (echo -n DiningTable_Light2_Off; sleep 0.3) | nc 192.168.5.20 8932\n// 即：纯 ASCII bytes，无 CRLF 分隔；连接关闭即触发 creator 解析。\n// tcp out 节点配 end:true 实现\"发完关连接\"短连接行为。\nmsg.payload = cmd;\nnode.status({ fill: \"green\", shape: \"dot\", text: cmd });\nreturn msg;\n","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":470,"y":40,"wires":[["av_control_tcp_p0"]]},{"id":"av_control_tcp_p0","type":"tcp out","z":"7c4ca99dac54bb67","name":"creator av/control 短连接","host":"192.168.5.20","port":"8932","beserver":"client","base64":false,"end":true,"x":850,"y":40,"wires":[]},{"id":"5f260125557286a5","type":"function","z":"268790cd7f96e910","name":"CREATOR AI 大脑 (思考判断 & 真数据桥接)","func":"// 初始化本地孪生状态\nlet localState = context.get('twin_state_v3') || {\n    vision: { detected: false, people_count: 0 },\n    audio: { detected: false, intent: 'NONE' },\n    equipment: { fsp_active: false }\n};\n\n// ==========================================\n// 1. 视觉通道处理 (av/video/detect)\n// ==========================================\nif (msg.topic === 'vision_eye') {\n    localState.vision.detected = msg.payload.people_count > 0;\n    localState.vision.people_count = msg.payload.people_count;\n}\n\n// ==========================================\n// 2. 语音通道处理 (av/audio/command)\n// ==========================================\nelse if (msg.payload) {\n    let cmdStr = typeof msg.payload === 'string' ? msg.payload : JSON.stringify(msg.payload);\n    if (cmdStr.length > 2) {\n        localState.audio.detected = true;\n        localState.audio.intent = 'COMMAND_RECEIVED';\n    }\n}\n\n// ==========================================\n// 中枢决策：感知任一激活 → FSP 矩阵激活\n// ==========================================\nif (localState.vision.detected || localState.audio.detected) {\n    localState.equipment.fsp_active = true;\n} else {\n    localState.equipment.fsp_active = false;\n}\n\ncontext.set('twin_state_v3', localState);\nlet outMsg = { topic: 'dashboard_update_v3', payload: localState };\n\n// ==========================================\n// 防抖式自动复位（连续语音保持点亮，停顿 2s 才熄）\n// ==========================================\nif (localState.audio.detected) {\n    let oldTimer = context.get('audio_reset_timer');\n    if (oldTimer) clearTimeout(oldTimer);\n    let newTimer = setTimeout(() => {\n        let resetState = context.get('twin_state_v3');\n        if (!resetState) return;\n        resetState.audio.detected = false;\n        resetState.audio.intent = 'NONE';\n        if (!resetState.vision.detected) {\n            resetState.equipment.fsp_active = false;\n        }\n        context.set('twin_state_v3', resetState);\n        context.set('audio_reset_timer', null);\n        node.send([{ topic: 'dashboard_update_v3', payload: resetState }, null]);\n    }, 2000);\n    context.set('audio_reset_timer', newTimer);\n}\n\nnode.send([outMsg, msg]);\nreturn null;","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":630,"y":380,"wires":[["dashboard_2.0_twin"],["b0cfb56c26f17f10","15ab4c0bb1fc3653"]]},{"id":"b0cfb56c26f17f10","type":"debug","z":"268790cd7f96e910","name":"软件执行 (OBS WS 切图)","active":true,"tosidebar":true,"console":false,"tostatus":true,"complete":"obs_cmd","targetType":"msg","statusVal":"\"已切PPT\"","statusType":"auto","x":950,"y":440,"wires":[]},{"id":"15ab4c0bb1fc3653","type":"debug","z":"268790cd7f96e910","name":"硬件执行 (TCP 矩阵指令)","active":true,"tosidebar":true,"console":false,"tostatus":true,"complete":"tcp_matrix_cmd","targetType":"msg","statusVal":"\"已发十六进制控制协议\"","statusType":"auto","x":950,"y":500,"wires":[]},{"id":"f30de3b3106f9fac","type":"inject","z":"268790cd7f96e910","name":"【真数据】视觉感知：摄像头有人","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"vision_eye","payload":"{\"zone\":\"沙盘区\",\"people_count\":2}","payloadType":"json","x":170,"y":220,"wires":[["5f260125557286a5"]]},{"id":"9cb7a7d3126804e4","type":"inject","z":"268790cd7f96e910","name":"【真数据】视觉感知：无人","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"vision_eye","payload":"{\"zone\":\"沙盘区\",\"people_count\":0}","payloadType":"json","x"