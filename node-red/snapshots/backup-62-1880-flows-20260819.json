se,"rap":true,"rh":0,"inputs":0,"x":150,"y":200,"wires":[["l3_rule1_fn"]]},{"id":"l3_rule1_fn","type":"function","z":"7c4ca99dac54bb67","name":"L3.规则1 人→灯","func":"// L3 规则 1：YOLO 检测到 person → 开 DiningTable_Light2_On\n// 5 分钟内无新检测 → 自动 DiningTable_Light2_Off\nconst LIGHT_OFF_MS = 5 * 60 * 1000;\n\n// 解 BaseModule 双层 wrap\nlet body = msg.payload;\nif (typeof body === \"string\") { try { body = JSON.parse(body); } catch (e) {} }\nif (body && typeof body === \"object\" && \"payload\" in body) body = body.payload;\n\nconst dets = (body && body.detections) || [];\nconst persons = dets.filter(d => d && d.class === \"person\").length;\n\nlet lit = flow.get(\"l3_rule1_lit\") || false;\nlet off_timer = flow.get(\"l3_rule1_off_timer\");\n\nif (persons > 0) {\n    // 重置 off timer\n    if (off_timer) clearTimeout(off_timer);\n    off_timer = setTimeout(function () {\n        if (flow.get(\"l3_rule1_lit\")) {\n            flow.set(\"l3_rule1_lit\", false);\n            flow.set(\"l3_rule1_off_timer\", null);\n            node.send({ topic: \"av/control\", payload: { cmd: \"DiningTable_Light2_Off\" } });\n            node.status({ fill: \"grey\", shape: \"ring\", text: \"5m 无人 → OFF\" });\n        }\n    }, LIGHT_OFF_MS);\n    flow.set(\"l3_rule1_off_timer\", off_timer);\n\n    if (!lit) {\n        flow.set(\"l3_rule1_lit\", true);\n        node.status({ fill: \"green\", shape: \"dot\", text: \"有人 → ON @\" + new Date().toLocaleTimeString() });\n        return { topic: \"av/control\", payload: { cmd: \"DiningTable_Light2_On\" } };\n    }\n}\nreturn null;\n","outputs":1,"timeout":0,"noerr":0,"initialize":"// 部署/重启时清 state，避免 lit 残留导致下次 person 来不发 ON\nflow.set(\"l3_rule1_lit\", false);\nconst t = flow.get(\"l3_rule1_off_timer\");\nif (t) clearTimeout(t);\nflow.set(\"l3_rule1_off_timer\", null);\n","finalize":"// redeploy/stop 时清掉 setTimeout 防 leak\nconst t = flow.get(\"l3_rule1_off_timer\");\nif (t) clearTimeout(t);\nflow.set(\"l3_rule1_off_timer\", null);\n","libs":[],"x":410,"y":200,"wires":[["l3_rule1_out"]]},{"id":"l3_rule1_out","type":"mqtt out","z":"7c4ca99dac54bb67","name":"av/control (L3.1)","topic":"av/control","qos":"0","retain":"false","broker":"2b41081ef4cf12c5","x":670,"y":200,"wires":[]},{"id":"l3_bri_in","type":"mqtt in","z":"7c4ca99dac54bb67","name":"av/env/brightness","topic":"av/env/brightness","qos":"0","datatype":"auto-detect","broker":"2b41081ef4cf12c5","nl":false,"rap":true,"rh":0,"inputs":0,"x":150,"y":320,"wires":[["l3_bri_cache"]]},{"id":"l3_bri_cache","type":"function","z":"7c4ca99dac54bb67","name":"缓存亮度","func":"// 缓存最近的环境亮度到 flow.l3_brightness 给规则 2 用\nlet body = msg.payload;\nif (typeof body === \"string\") { try { body = JSON.parse(body); } catch (e) {} }\nif (body && typeof body === \"object\" && \"payload\" in body) body = body.payload;\nif (body && typeof body.brightness === \"number\") {\n    flow.set(\"l3_brightness\", body.brightness);\n    flow.set(\"l3_brightness_ts\", Date.now());\n    node.status({ fill: \"blue\", shape: \"dot\", text: \"亮度 \" + body.brightness });\n}\nreturn null;\n","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":380,"y":320,"wires":[[]]},{"id":"l3_rule2_inject","type":"inject","z":"7c4ca99dac54bb67","name":"每天 13:00","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"00 13 * * *","once":false,"onceDelay":0.1,"topic":"l3_rule2_cron","payload":"","payloadType":"str","x":150,"y":420,"wires":[["l3_rule2_fn"]]},{"id":"l3_rule2_fn","type":"function","z":"7c4ca99dac54bb67","name":"L3.规则2 时间+亮度→帘","func":"// L3 规则 2：cron 13:00 触发 → 检查最近亮度，> 阈值则发 close\n// 输出 1：close 立即；输出 2：stop 经 delay 1s（在外部 delay 节点）\nconst BRIGHT_THRESHOLD = 180;  // 0-255 mean luminance；调高=只在更亮时触发\nconst STALE_MS = 5 * 60 * 1000; // 亮度数据超过 5 分钟视为无效\n\nconst bri = flow.get(\"l3_brightness\");\nconst bri_ts = flow.get(\"l3_brightness_ts\") || 0;\nif (typeof bri !== \"number\" || (Date.now() - bri_ts) > STALE_MS) {\n    node.warn(\"L3.规则2 触发但亮度数据缺失/过期，跳过\");\n    node.status({ fill: \"yellow\", shape: \"ring\", text: \"亮度无数据，跳过\" });\n    return null;\n}\nif (bri < BRIGHT_THRESHOLD) {\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"亮度 \" + bri + \" 不够亮，跳过\" });\n    return null;\n}\nnode.status({ fill: \"green\", shape: \"dot\", text: \"13:00 大太阳 \" + bri + \" → 关帘 1s\" });\n// 立即 close + 1s 后 stop（stop 走 delay 节点）\nconst close_msg = { topic: \"av/control\", payload: { cmd: \"BarCounter_Curtain_Close\" } };\nconst stop_msg  = { topic: \"av/control\", payload: { cmd: \"BarCounter_Curtain_Stop\" } };\nreturn [close_msg, stop_msg];\n","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":420,"wires":[["l3_rule2_out"],["l3_rule2_delay"]]},{"id":"l3_rule2_delay","type":"delay","z":"7c4ca99dac54bb67","name":"1s 后","pauseType":"delay","timeout":"1","timeoutUnits":"seconds","rate":"1","nbRateUnits":"1","rateUnits":"second","randomFirst":"1","randomLast":"5","randomUnits":"seconds","drop":false,"allowrate":false,"outputs":1,"x":670,"y":470,"wires":[["l3_rule2_out"]]},{"id":"l3_rule2_out","type":"mqtt out","z":"7c4ca99dac54bb67","name":"av/control (L3.2)","topic":"av/control","qos":"0","retain":"false","broker":"2b41081ef4cf12c5","x":870,"y":420,"wires":[]},{"id":"6381f8389711479e","type":"tab","label":"演示中控(全功能)","disabled":false,"info":"经.20:8932明文口tcp out短连接;LED走PDU"},{"id":"61ca670fe920492f","type":"ui-page","name":"演示中控","ui":"11692f75b65a4c92","path":"/control","icon":"remote","layout":"notebook","theme":"cd3302c01d38a9e1","order":8,"className":"","visible":true,"disabled":false},{"id":"449d2800e80b465b","type":"ui-group","name":"","page":"61ca670fe920492f","width":"24","height":"1","order":1,"showTitle":false,"className":"","visible":true,"disabled":false},{"id":"ecbb87e4dbf64ff4","type":"ui-template","z":"6381f8389711479e","group":"449d2800e80b465b","page":"","ui":"","name":"中控面板","order":1,"width":"24","height":"24","head":"","format":"<template>\n<div class=\"cc\">\n  <div class=\"top\">\n